# Local development URLs — read by `next dev` only.
#
# Copy this file to `.env` and adjust if your ports differ. Both names MUST
# keep the `NEXT_PUBLIC_` prefix: the app reads them in browser code as well,
# and Next.js only inlines `NEXT_PUBLIC_` variables into the client bundle
# (at build time — restart `next dev` after changing them).
#
#   NEXT_PUBLIC_LOCAL_SERVER_URL  API server  (trust-pass-server, port 5000)
#   NEXT_PUBLIC_LOCAL_CLIENT_URL  this app    (port 3000)
#
# Production needs NO environment variables: `next build` and any deploy use
# the LIVE links hardcoded in lib/core/env.ts, and `.env` is gitignored so it
# never reaches the deploy.
#
# NEXT_PUBLIC_BASE_URL is no longer used — do not set it.

NEXT_PUBLIC_LOCAL_SERVER_URL=http://localhost:5000
NEXT_PUBLIC_LOCAL_CLIENT_URL=http://localhost:3000
