# Copy to `.env` if you want to override the default. Both values below are
# OPTIONAL — the app resolves them automatically from the environment, and the
# browser talks to the API server directly, so only `NEXT_PUBLIC_` values matter.

# API server origin. Leave unset to auto-select:
#   local      -> http://localhost:5000
#   production -> https://trust-pass-server.vercel.app
# NEXT_PUBLIC_SERVER_URL=

# Cloudinary unsigned upload preset
NEXT_PUBLIC_CLOUDINARY_SECURE_DISTRIBUTION=
