# Base URL of the Trust Pass API server.
#
# This is the ONLY environment variable this app reads. Auth, session, OTP and
# every other request go to this origin.
#
# For local development, run the server on your machine (trust-pass-server,
# `npm run dev`, which listens on port 5000) and point this at it:
NEXT_PUBLIC_BASE_URL=http://localhost:5000